border:1px solid #819b8b;background:#fffef6;font:650 .9rem system-ui;color:var(--g);min-height:42px;padding:.55em .85em;cursor:pointer}.action .primary,.filters button[aria-pressed=true]{background:var(--g);color:white;border-color:var(--g)}.status{font-size:.86rem;color:var(--muted);min-height:1.5em}.error{color:#9b2926;font-weight:650}.plan-grid{display:grid;grid-template-columns:.86fr 1.14fr;gap:1.15rem;margin-top:1rem;align-items:start}.wave{display:flex;gap:.6rem;padding:.52rem 0;border-bottom:1px solid #dde4d9}.wave b{flex:0 0 2rem;font:700 1rem var(--mono);color:#58776c;padding-top:.16em}.wave>div{display:flex;gap:.35em;flex-wrap:wrap}.chip{display:inline-block;overflow-wrap:anywhere;background:#e6eee4;border:1px solid #c8d6c9;border-radius:3px;color:#244b41;padding:.22em .4em;font:.83rem var(--mono)}.hold{background:#fff0d5;border-color:#d3b380;color:#63451c}.keys{display:flex;align-items:center;gap:.5em;margin:.7em 0 .2em;color:var(--muted);font-size:.84rem}.filters{display:flex;gap:.45rem;flex-wrap:wrap;margin:1.1rem 0}.role-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.role{align-self:start;border:1px solid #bfcec0;border-radius:3px;background:#fffefa;padding:.35rem .85rem}.role summary{color:var(--ink);display:flex;gap:.6rem;align-items:baseline;list-style:none;min-height:42px}.role summary:after{content:'+';margin-left:auto;color:#628373}.role[open] summary:after{content:'−'}.no{font:.77rem var(--mono);color:#467760}.role .when{color:var(--muted);font-size:.86rem;margin-bottom:.5rem}.role p{font-size:.92rem}.role dt{margin-top:.45em;color:#456858;font:650 .73rem var(--mono);letter-spacing:.035em;text-transform:uppercase}.role dd{margin:.2em 0 .65em}.rules{counter-reset:rule;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:.9rem 1.5rem;padding:0}.rules li{border-top:2px solid #b2c4b5;padding:.7em .1em;color:var(--muted)}.rules li:before{counter-increment:rule;content:'0'counter(rule)' / ';font:.77rem var(--mono)