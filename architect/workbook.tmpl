'use strict';const roles=@@ROLES@@,presets=@@PRESETS@@,bench=@@BENCH@@;const $=id=>document.getElementById(id),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),rname=id=>roles.find(r=>r[0]===id)?.[2];const byId=x=>x.map(t=>t.id);let plan=null;
const field=id=>$(id).value,needed=(ok,msg)=>{if(!ok)throw Error(msg)};function levels(p){needed(p.objective.trim(),'Het doel ontbreekt.');for(const [k,a,b] of [['cap',1,4],['deadline_s',1,900],['max_calls',1,120]])needed(Number.isInteger(p[k])&&p[k]>=a&&p[k]<=b,`${k}: kies ${a}–${b}.`);const ts=p.tasks;needed(Array.isArray(ts)&&ts.length&&ts.length<=40,'Kies 1–40 taken.');const ids=new Set,outs=new Set;for(const t of ts){needed(t&&typeof t==='object'&&typeof t.id==='string'&&/^[a-z0-9][a-z0-9-]{0,39}$/.test(t.id)&&!ids.has(t.id),'Taak-ID ongeldig of dubbel.');ids.add(t.id);needed(rname(t.role),t.id+': onbekende rol.');for(const k of ['goal','out','check'])needed(typeof t[k]==='string'&&t[k].trim(),t.id+': '+k+' ontbreekt.');const o=t.out.trim().toLowerCase();needed(!outs.has(o),'Twee eigenaren voor '+t.out+'.');outs.add(o);needed(['read','draft','verify','approval'].includes(t.mode),t.id+': ongeldige modus.');if('estimate_ms'in t)needed(Number.isInteger(t.estimate_ms)&&t.estimate_ms>=1&&t.estimate_ms<=600000,t.id+': ongeldige schatting.');if('timeout_s'in t)needed(Number.isFinite(t.timeout_s)&&t.timeout_s>=.001&&t.timeout_s<=900,t.id+': ongeldige time-out.');for(const k of ['needs','optional'])if(k in t)needed(Array.isArray(t[k])&&t[k].every(v=>typeof v==='string'),t.id+': '+k+' moet een lijst met IDs zijn.');}for(const t of ts){const d=[...(t.needs||[]),...(t.optional||[])];needed(new Set(d).size===d.length&&d.every(i=>i!==t.id&&ids.has(i)),t.id+': ongeldige voorganger.');}const done=new Set,layers=[];while(done.size<ts.length){const l=ts.filter(t=>!done.has(t.id)&&[...(t.needs||[]),...(t.optional||[])].every(i=>done.has(i)));needed(l.length,'Cyclus gevonden; verwijder een terugwijzende pijl.');layers.push(l);l.forEach(t=>done.add(t.id));}return layers;}
function briefing(p){return `@architect — DOEL\n${p.objective}\n\nROUTE EN DOCTRINE\nKies het kortste pad dat de toetsen haalt. Antwoord direct bij laag risico. Vraag één beslissend ontbrekend gegeven; laat onafhankelijk werk doorgaan. Virtuele rollen zijn geen aangestelde personen. Gebruik alleen beschikbare sessies en toegestane tools; simuleer geen uitgevoerde acties.\nBudget: maximaal ${p.cap} gelijktijdige werksessie(s), ${p.max_calls} adapteraanroep(en), ${p.deadline_s} s totaal. Stel token- en geldlimieten vast vóór betaalde aanroepen. Begin bij het kritieke pad. Ieder outputobject heeft één eigenaar. Geef alleen noodzakelijke context en bronversie door.\n\nWERKPAKKETTEN\n`+p.tasks.map(t=>`${t.id} | ${String(t.role).padStart(2,'0')} ${rname(t.role)} | ${t.mode}\nDoel: ${t.goal}\nVereist: ${(t.needs||[]).join(', ')||'—'}; optioneel: ${(t.optional||[]).join(', ')||'—'}\nLever: ${t.out}\nKlaar als: ${t.check}${t.blocked?'\nGEBLOKKEERD: '+t.blocked:''}${t.mode==='approval'?'\nSTOP: afzonderlijke menselijke toestemming.':''}`).join('\n\n')+`\n\nAFSLUITING\nElke sessie meldt status, bewijs/vindplaats, open punt en volgende eigenaar. Hoogstens één nieuwe poging bij een expliciet tijdelijke leesfout; schrijf/publiceer nooit opnieuw zonder controle. Bij conflict verifieert één onafhankelijke toetser de beslissende claim. Geef één antwoord met bruikbare resultaten, niet-bevestigde onderdelen en zo nodig één vervolgvraag. Meet tijd tot bruikbaar antwoord, p95, kwaliteit en kosten per geslaagde taak; claim geen winst zonder vergelijkbare baseline.`;}
function render(){plan=null;$('actionStatus').textContent='';try{const p={version:1,objective:field('objective'),cap:+field('cap'),deadline_s:+field('deadline'),max_calls:+field('budget'),tasks:JSON.parse(field('taskjson'))},ls=levels(p);plan=p;$('waves').innerHTML=ls.map((l,i)=>`<div class="wave"><b>${String(i+1).padStart(2,'0')}</b><div>${l.map(t=>`<span class="chip ${t.blocked||t.mode==='approval'?'hold':''}">${esc(t.id)}${t.blocked||t.mode==='approval'?' · wacht':''}</span>`).join('')}</div></div>`).join('');$('brief').value=briefing(p);$('jsonout').value=JSON.stringify(p,null,2);$('planbody').hidden=false;$('valid').className='status';$('valid').textContent=`Plan geldig · ${p.tasks.length} werkpakket${p.tasks.length===1?'':'ten'} · ${ls.length} ${ls.length===1?'laag':'lagen'} · maximaal ${p.cap} tegelijk.`;}catch(e){$('planbody').hidden=true;$('valid').className='status error';$('valid').textContent='Plan niet gereed: '+e.message;}}
function preset(k){const p=presets[k];$('objective').value=p.objective;$('cap').value=p.cap;$('deadline').value=p.deadline_s;$('budget').value=p.max_calls;$('taskjson').value=JSON.stringify(p.tasks,null,2);render();}$('preset').innerHTML=Object.entries(presets).map(([k,p])=>`<option value="${k}">${esc(p.title)}</option>`).join('');$('preset').value='renderstudio';preset('renderstudio');$('preset').onchange=e=>preset(e.target.value);for(const id of ['objective','cap','deadline','budget','taskjson'])$(id).oninput=render;
$('copy').onclick=async()=>{if(!plan)return;const t=$('brief');try{await navigator.clipboard.writeText(t.value);$('actionStatus').textContent='Briefing gekopieerd.';}catch{t.focus();t.select();let ok=false;try{ok=document.execCommand('copy')}catch{}$('actionStatus').textContent=ok?'Briefing gekopieerd.':'Briefing geselecteerd. Gebruik Kopieer of Ctrl/Cmd+C.';}};$('export').onclick=()=>{if(!plan)return;const u=URL.createObjectURL(new Blob([JSON.stringify(plan,null,2)],{type:'application/json'})),a=document.createElement('a');a.href=u;a.download='architect-plan.json';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),2500);$('actionStatus').textContent='Download aangevraagd. Geblokkeerd in een preview? Kopieer het uitwisselbare plan hieronder.';};
function team(group){const groups=['Alle rollen',...new Set(roles.map(r=>r[1]))];if(!$('filters').children.length)$('filters').innerHTML=groups.map(g=>`<button type="button" data-group="${g}">${g}</button>`).join('');for(const b of $('filters').children)b.setAttribute('aria-pressed',b.dataset.group===group);$('roles').innerHTML=roles.filter(r=>group==='Alle rollen'||r[1]===group).map(([n,g,name,when,task,out,gate])=>`<details class="role"><summary><span class="no">${String(n).padStart(2,'0')}</span> <span>${esc(name)}</span></summary><p class="when">${esc(g)} · ${esc(when)}</p><p>${esc(task)}</p><dl><dt>Afleverstuk</dt><dd>${esc(out)}</dd><dt>Toets</dt><dd>${esc(gate)}</dd></dl></details>`).join('');}$('filters').onclick=e=>{const b=e.target.closest('button');if(b)team(b.dataset.group)};team('Alle rollen');const a=bench.caps['1'],b=bench.caps['2'],nl=n=>String(n).replace('.',',');$('bars').innerHTML=[[a,'Serieel · 1 plek'],[b,'Parallel · 2 plekken']].map(([v,n])=>`<div class="bartext"><span>${n}</span><b>${nl(v.p50_ms)} ms</b></div><div class="bar"><i style="width:${100*v.p50_ms/a.p50_ms}%"></i></div>`).join('');$('benchNote').textContent=`Mediaan (p50) over ${bench.trials_per_route} gepaarde runs na opwarming. p95: ${nl(a.p95_ms)} versus ${nl(b.p95_ms)} ms. Zelfde vier adapteraanroepen en identieke uitvoervingerafdruk. Kunstmatige I/O-wachten; nul modelaanroepen. Geen claim over de snelheid van jouw chatbot.`;
</script></html>